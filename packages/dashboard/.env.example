PORT=4500
PULSE_DB_PATH=pulse-dashboard.sqlite
# Required in production: a random secret of 16+ characters, used to encrypt project API keys.
PULSE_MASTER_KEY=change-me-to-a-random-32-byte-secret
# Required in production: the token the UI (and any API client) sends as "Authorization: Bearer <token>".
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development, if unset, a temporary token is printed at startup.
PULSE_ADMIN_TOKEN=
PULSE_UI_ORIGIN=http://localhost:3000
PULSE_POLL_INTERVAL_MS=20000
# Cached metrics older than this are deleted hourly. 0 keeps everything.
PULSE_RETENTION_DAYS=14
# Production only: http:// export URLs are refused unless this is 1.
# PULSE_ALLOW_HTTP=1
# Production only: private/loopback export hosts are refused unless listed here (comma separated hostnames).
# PULSE_ALLOWED_HOSTS=my-app,10.0.0.5
