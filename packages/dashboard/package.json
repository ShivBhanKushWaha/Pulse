{
  "name": "@shiv-kush/pulse-dashboard",
  "version": "0.1.2",
  "description": "Pulse dashboard: one command to run the dashboard (UI + API) on your laptop or server. Polls the /_pulse/export route of every project that uses @shiv-kush/pulse-monitor-sdk.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && pnpm run build:ui",
    "build:ui": "pnpm --filter pulse-ui build:static && node scripts/copy-ui.mjs",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "bin": {
    "pulse-dashboard": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "monitoring",
    "dashboard",
    "pulse",
    "self-hosted",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivBhanKushWaha/pulse.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/ShivBhanKushWaha/pulse/tree/main/packages/dashboard#readme",
  "bugs": {
    "url": "https://github.com/ShivBhanKushWaha/pulse/issues"
  }
}
