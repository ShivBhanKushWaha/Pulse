{
  "name": "pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:dashboard": "pnpm --filter @shiv-kush/pulse-dashboard dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.3.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.9",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "proxy-addr": "^2.0.8",
      "body-parser@<1.20.9": "^1.20.9",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "brace-expansion@<1.1.20": "^1.1.20",
      "next>postcss": "^8.5.18",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2",
      "qs@<6.16.1": "^6.16.1"
    }
  }
}
